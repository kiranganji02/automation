# ==========================================
# FIREBASE CLOUD FIRESTORE CONFIGURATION
# ==========================================
# Get these keys from: https://console.firebase.google.com/
# Go to: Project Settings -> General -> Your apps -> Web App SDK Setup
#
# Once added, restart the dev server to reload environment variables.
# You can also configure them directly in the website via the "Database" button in the top navigation!

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
